# ==============================================================================
# PulsePilot AI Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FLAGSMITH EXPERIMENTATION INTEGRATION
# ------------------------------------------------------------------------------
# Client-side Flagsmith Environment Key (Safe for browser / Client SDK)
FLAGSMITH_ENVIRONMENT_KEY=

# Server-side Flagsmith Management / Server API Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used to programmatically create multivariate flags, experiments, metrics and retrieve results
FLAGSMITH_SERVER_SIDE_API_KEY=

# Base URL for Flagsmith Management REST API (Defaults to Flagsmith Cloud)
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1/

# Base URL for Flagsmith Event & Telemetry Ingestion
FLAGSMITH_EVENTS_URL=https://events.flagsmith.com/api/v1/

# Flagsmith Project ID
FLAGSMITH_PROJECT_ID=

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI ENGINE
# ------------------------------------------------------------------------------
# Google AI Studio API Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. DATABASE & PRISMA (POSTGRESQL / SUPABASE)
# ------------------------------------------------------------------------------
# Direct connection string to PostgreSQL database
DATABASE_URL=
DIRECT_URL=

# ------------------------------------------------------------------------------
# 4. SUPABASE AUTHENTICATION
# ------------------------------------------------------------------------------
# Public Supabase project URL (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase Anonymous Key (Safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Private Supabase Service Role Key (SERVER-SIDE ONLY)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 5. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
