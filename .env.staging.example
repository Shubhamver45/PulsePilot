# =============================================================================
# PULSEPILOT AI — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.staging.example
# Security Notice: NEVER copy production credentials into this file.
# =============================================================================

# 1. DEDICATED STAGING SUPABASE POSTGRESQL CONNECTIONS
# Required for SEC-03.1 DBA tests and staging Prisma migrations.
# Project Reference MUST be distinct from production ('czqhiuidekvozuoqdmyd').
STAGING_DATABASE_URL="postgresql://postgres:<STAGING_DB_PASSWORD>@db.<STAGING_PROJECT_REF>.supabase.co:5432/postgres"
STAGING_DIRECT_URL="postgresql://postgres:<STAGING_DB_PASSWORD>@db.<STAGING_PROJECT_REF>.supabase.co:5432/postgres"

# 2. APPLICATION RUNTIME ROLE (Post-Provisioning Stage 3)
# Used once 'pulsepilot_app' least-privilege role is provisioned on staging:
STAGING_APP_DATABASE_URL="postgresql://pulsepilot_app:<STAGING_APP_PASSWORD>@db.<STAGING_PROJECT_REF>.supabase.co:5432/postgres"

# 3. STAGING SUPABASE API IDENTIFIERS
# Distinct Supabase project credentials for staging testing
NEXT_PUBLIC_SUPABASE_URL="https://<STAGING_PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<STAGING_SUPABASE_ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<STAGING_SUPABASE_SERVICE_ROLE_KEY>"

# 4. STAGING AUTHENTICATION
# Separate random 32+ character HMAC-SHA256 signing secret for staging tokens
SESSION_SECRET="<STAGING_RANDOM_SESSION_SECRET_MIN_32_CHARS>"

# 5. STAGING FLAGSMITH FEATURE FLAGS
# Dedicated Flagsmith staging environment keys (isolated from production toggles)
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_KEY="<STAGING_FLAGSMITH_CLIENT_KEY>"
FLAGSMITH_SERVER_SIDE_API_KEY="<STAGING_FLAGSMITH_SERVER_KEY>"

# 6. STAGING ENVIRONMENT IDENTIFICATION
NODE_ENV="staging"
APP_TARGET_ENVIRONMENT="staging"

