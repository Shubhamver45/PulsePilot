# =============================================================================
# PULSEPILOT AI — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.staging.example
# Security Notice: NEVER copy production credentials into this file.
# =============================================================================

# 1. MANDATORY INDEPENDENT STAGING PROJECT REFERENCE
# Must be a valid Supabase project reference (lowercase alphanumeric, 12-40 chars).
# Under NO circumstances should this match production ('czqhiuidekvozuoqdmyd').
STAGING_PROJECT_REF="yourstagingprojectref123"

# 2. DEDICATED STAGING SUPABASE POSTGRESQL CONNECTIONS
# Required for SEC-03.2 DBA tests and staging Prisma migrations.
# Target host MUST agree with STAGING_PROJECT_REF above (db.<STAGING_PROJECT_REF>.supabase.co).
# Zero fallback to DATABASE_URL or DIRECT_URL is strictly enforced.
# Explicit sslmode=verify-full is strictly required for all staging connections.
STAGING_DATABASE_URL="postgresql://postgres:<STAGING_DB_PASSWORD>@db.yourstagingprojectref123.supabase.co:5432/postgres?sslmode=verify-full"
STAGING_DIRECT_URL="postgresql://postgres:<STAGING_DB_PASSWORD>@db.yourstagingprojectref123.supabase.co:5432/postgres?sslmode=verify-full"

# 3. APPLICATION RUNTIME ROLE (Post-Provisioning Stage 2)
# Used once 'pulsepilot_app' least-privilege role is provisioned on staging:
STAGING_APP_DATABASE_URL="postgresql://pulsepilot_app:<STAGING_APP_PASSWORD>@db.yourstagingprojectref123.supabase.co:5432/postgres?sslmode=verify-full"

# 4. STAGING SUPABASE API IDENTIFIERS
# Distinct Supabase project credentials for staging testing
NEXT_PUBLIC_SUPABASE_URL="https://yourstagingprojectref123.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<STAGING_SUPABASE_ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<STAGING_SUPABASE_SERVICE_ROLE_KEY>"

# 5. STAGING AUTHENTICATION
# Separate random 32+ character HMAC-SHA256 signing secret for staging tokens
SESSION_SECRET="<STAGING_RANDOM_SESSION_SECRET_MIN_32_CHARS>"

# 6. STAGING FLAGSMITH FEATURE FLAGS
# Dedicated Flagsmith staging environment keys (isolated from production toggles)
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_KEY="<STAGING_FLAGSMITH_CLIENT_KEY>"
FLAGSMITH_SERVER_SIDE_API_KEY="<STAGING_FLAGSMITH_SERVER_KEY>"

# 7. STAGING ENVIRONMENT IDENTIFICATION
NODE_ENV="staging"
APP_TARGET_ENVIRONMENT="staging"
